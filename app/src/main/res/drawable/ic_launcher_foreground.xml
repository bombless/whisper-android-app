    <!-- Bus circuit traces from outer corners to NPU core -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00E5FF"
        android:strokeWidth="1.8"
        android:strokeAlpha="0.65"
        android:strokeLineCap="round"
