    <path
        android:fillColor="#00000000"
        android:strokeColor="#7DD3FC"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.8"
        android:pathData="M54,54 L54,45 M54,54 L62,49.5 M54,54 L62,58.5 M54,54 L54,63 M54,54 L46,58.5 M54,54 L46,49.5" />

    <!-- Neural ring interconnect -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#38BDF8"
        android:strokeWidth="0.8"
        android:strokeAlpha="0.5"
        android:pathData="M54,45 L62,49.5 L62,58.5 L54,63 L46,58.5 L46,49.5 Z" />

    <!-- Multimodal compute satellite nodes -->
    <!-- Voice / Whisper STT (Cyan) -->
