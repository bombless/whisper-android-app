    <path android:fillColor="#818CF8" android:pathData="M54,82 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0" />
    <path android:fillColor="#60A5FA" android:pathData="M30,68 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0" />
    <path android:fillColor="#38BDF8" android:pathData="M30,40 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0" />

    <!-- Inner NPU Processor Hexagon Core -->
    <path
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,39 L67,46.5 L67,61.5 L54,69 L41,61.5 L41,46.5 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="41"
                android:startY="39"
                android:endX="67"
                android:endY="69"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="1.0" android:color="#C084FC" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="39"
                android:endX="54"
                android:endY="69"
                android:type="linear">
                <item android:offset="0.0" android:color="#E00B1736" />
                <item android:offset="1.0" android:color="#E0111E48" />
            </gradient>
        </aapt:attr>
