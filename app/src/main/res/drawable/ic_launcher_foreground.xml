    <path android:fillColor="#67E8F9" android:pathData="M54,19 m-1.0,0 a1.0,1.0 0 1 0 2.0,0 a1.0,1.0 0 1 0 -2.0,0" />
    <path android:fillColor="#67E8F9" android:pathData="M54,89 m-1.0,0 a1.0,1.0 0 1 0 2.0,0 a1.0,1.0 0 1 0 -2.0,0" />

