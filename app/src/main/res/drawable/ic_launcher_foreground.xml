    <path android:fillColor="#67E8F9" android:pathData="M54,54 m-3.6,0 a3.6,3.6 0 1 0 7.2,0 a3.6,3.6 0 1 0 -7.2,0" />
    <path android:fillColor="#FFFFFF" android:pathData="M54,54 m-2.0,0 a2.0,2.0 0 1 0 4.0,0 a2.0,2.0 0 1 0 -4.0,0" />

