    <!-- LLM Chat (Electric Violet) -->
    <path android:fillColor="#A78BFA" android:pathData="M62,49.5 m-2.2,0 a2.2,2.2 0 1 0 4.4,0 a2.2,2.2 0 1 0 -4.4,0" />
