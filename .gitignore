# Machine-specific build config. gradle.properties is tracked with the portable defaults only;
# per-machine settings (notably org.gradle.java.home) belong in ~/.gradle/gradle.properties.
# The build needs JDK 17–21: Kotlin 2.1.21 cannot parse the version string of JDK 22+ and
# fails with `java.lang.IllegalArgumentException: 25.0.3` during compilation.
gradle.properties
