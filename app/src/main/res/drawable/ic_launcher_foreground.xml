        android:pathData="M54,26 L78,40 L78,68 L54,82 L30,68 L30,40 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="26"
                android:endX="78"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F2FE" />
                <item android:offset="0.5" android:color="#38BDF8" />
                <item android:offset="1.0" android:color="#818CF8" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="26"
                android:endX="54"
