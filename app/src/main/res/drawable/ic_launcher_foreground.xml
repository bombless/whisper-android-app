    <!-- Vector Engine (Sky Blue) -->
    <path android:fillColor="#38BDF8" android:pathData="M46,49.5 m-2.2,0 a2.2,2.2 0 1 0 4.4,0 a2.2,2.2 0 1 0 -4.4,0" />

